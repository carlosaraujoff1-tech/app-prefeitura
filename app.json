{
  "expo": {
    "name": "SAP Cidadão",
    "slug": "sap-cidadao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sapcidadao",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "br.gov.pr.santoantoniodaplatina.sapcidadao",
      "supportsTablet": true
    },
    "android": {
      "package": "br.gov.pr.santoantoniodaplatina.sapcidadao",
      "adaptiveIcon": {
        "backgroundColor": "#0B4A8F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4A8F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SAP Cidadão usa sua localização para mostrar a distância até os locais da cidade e marcar onde está o problema que você quer informar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O SAP Cidadão precisa acessar suas fotos para você anexar imagens às solicitações.",
          "cameraPermission": "O SAP Cidadão usa a câmera para você fotografar o problema que quer informar à Prefeitura.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9e7c3848-337a-432f-b4dc-711d416fd6b6"
      }
    },
    "owner": "carlosaraujo1308s-team",
    "updates": {
      "url": "https://u.expo.dev/9e7c3848-337a-432f-b4dc-711d416fd6b6"
    }
  }
}
